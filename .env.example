# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings → API Keys, and the Project URL).
# .env.local is git-ignored; never commit real keys.

# --- Safe for the browser ---------------------------------------------------
# NEXT_PUBLIC_ variables are copied into the browser's JavaScript.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (starts with sb_publishable_). With RLS on and no policies,
# it can't read or write any app table.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Server only ------------------------------------------------------------
# Secret key (starts with sb_secret_). Bypasses RLS. Must NOT start with
# NEXT_PUBLIC_, and must never be sent to the browser or pasted anywhere public.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- E2E tests only -----------------------------------------------------------
# Base address for e2e test accounts. Each test signs up as
# <name>+test<digits>@<domain>, and the daily cleanup deletes only addresses
# of exactly that form. Kept out of the code because the repo is public.
E2E_EMAIL_BASE=name@example.com
